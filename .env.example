# Optional Alpha Vantage key for re-downloading source data.
# Copy this file to .env and fill in your own key:
#
#   cp .env.example .env
#   # edit .env
#   set -a; source .env; set +a
#
# The submitted dataset is already included, so this is only needed if the
# reviewer wants to re-run the Alpha Vantage download scripts.
ALPHAVANTAGE_API_KEY=
